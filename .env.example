# Copy to .env and fill in. Only the Groq key is required.
GROQ_API_KEY=
# Model: Groq by default; any OpenAI-compatible open-weight server works (see README "Models")
# EVE_LLM_PROVIDER=groq            # groq | ollama | vllm | openrouter | hf | openai
# EVE_MODEL=qwen/qwen3.8-27b
# EVE_LLM_BASE_URL=                # override the endpoint
# OPENROUTER_API_KEY=  HF_TOKEN=   # for those providers
# EVE_SUMMARY_EVERY=3
# EVE_KEEP_RECENT_TURNS=2
# EVE_MAX_TOOL_CALLS=10
